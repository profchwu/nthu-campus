  "questions": [
    {"id":"K1-001","grade":"K1","question":"小明有 5 顆球，又得到 3 顆，共有幾顆？","options":{"A":"7","B":"8","C":"9","D":"10"},"answer":"B","explanation":"5 + 3 = 8。"},
    {"id":"K1-002","grade":"K1","question":"9 枝鉛筆送出 4 枝，還剩幾枝？","options":{"A":"4","B":"6","C":"5","D":"3"},"answer":"C","explanation":"9 − 4 = 5。"},
    {"id":"K1-003","grade":"K1","question":"下面哪一個數最大？","options":{"A":"12","B":"9","C":"15","D":"11"},"answer":"C","explanation":"15 大於 12、11 和 9。"},
    {"id":"K1-004","grade":"K1","question":"三角形有幾條邊？","options":{"A":"2","B":"3","C":"4","D":"5"},"answer":"B","explanation":"三角形有 3 條邊。"},
    {"id":"K1-005","grade":"K1","question":"依序數：2、4、6，接下來是多少？","options":{"A":"7","B":"10","C":"8","D":"9"},"answer":"C","explanation":"每次加 2，6 + 2 = 8。"},
    {"id":"K1-006","grade":"K1","question":"13 是幾個十和幾個一？","options":{"A":"1 個十和 3 個一","B":"3 個十和 1 個一","C":"1 個十和 1 個一","D":"3 個十和 3 個一"},"answer":"A","explanation":"13 = 10 + 3。"},
    {"id":"K2-001","grade":"K2","question":"每袋 4 顆糖，3 袋共有幾顆？","options":{"A":"7","B":"10","C":"12","D":"16"},"answer":"C","explanation":"4 × 3 = 12。"},
    {"id":"K2-002","grade":"K2","question":"24 + 18 等於多少？","options":{"A":"32","B":"42","C":"40","D":"44"},"answer":"B","explanation":"24 + 10 + 8 = 42。"},
    {"id":"K2-003","grade":"K2","question":"50 − 27 等於多少？","options":{"A":"33","B":"27","C":"23","D":"17"},"answer":"C","explanation":"50 − 20 − 7 = 23。"},
    {"id":"K2-004","grade":"K2","question":"2 公尺等於幾公分？","options":{"A":"20","B":"100","C":"200","D":"2000"},"answer":"C","explanation":"1 公尺 = 100 公分，2 公尺 = 200 公分。"},
    {"id":"K2-005","grade":"K2","question":"從上午 9 點到上午 11 點，經過幾小時？","options":{"A":"1","B":"2","C":"3","D":"4"},"answer":"B","explanation":"11 − 9 = 2 小時。"},
    {"id":"K2-006","grade":"K2","question":"6 × 5 等於多少？","options":{"A":"11","B":"25","C":"35","D":"30"},"answer":"D","explanation":"6 × 5 = 30。"},
    {"id":"K3-001","grade":"K3","question":"24 顆糖平均分給 6 人，每人幾顆？","options":{"A":"3","B":"4","C":"6","D":"8"},"answer":"B","explanation":"24 ÷ 6 = 4。"},
    {"id":"K3-002","grade":"K3","question":"長方形長 8 公分、寬 3 公分，周長多少公分？","options":{"A":"11","B":"24","C":"22","D":"16"},"answer":"C","explanation":"周長 = (8 + 3) × 2 = 22 公分。"},
    {"id":"K3-003","grade":"K3","question":"一個蛋糕平均切成 4 份，吃掉 1 份，是吃了整個的多少？","options":{"A":"1/2","B":"1/3","C":"1/4","D":"3/4"},"answer":"C","explanation":"4 等份中的 1 份是 1/4。"},
    {"id":"K3-004","grade":"K3","question":"125 × 3 等於多少？","options":{"A":"375","B":"325","C":"350","D":"425"},"answer":"A","explanation":"125 + 125 + 125 = 375。"},
    {"id":"K3-005","grade":"K3","question":"35 ÷ 4 的商和餘數是多少？","options":{"A":"商 9 餘 1","B":"商 7 餘 7","C":"商 8 餘 3","D":"商 8 餘 4"},"answer":"C","explanation":"4 × 8 + 3 = 35，且餘數 3 小於 4。"},
    {"id":"K3-006","grade":"K3","question":"1 公斤 200 公克等於幾公克？","options":{"A":"120","B":"1020","C":"1002","D":"1200"},"answer":"D","explanation":"1000 + 200 = 1200 公克。"},
    {"id":"K4-001","grade":"K4","question":"3/8 + 2/8 等於多少？","options":{"A":"5/16","B":"5/8","C":"1/8","D":"6/8"},"answer":"B","explanation":"分母相同，分子相加：3/8 + 2/8 = 5/8。"},
    {"id":"K4-002","grade":"K4","question":"長方形長 12 公分、寬 5 公分，面積是多少平方公分？","options":{"A":"17","B":"34","C":"60","D":"120"},"answer":"C","explanation":"面積 = 12 × 5 = 60 平方公分。"},
    {"id":"K4-003","grade":"K4","question":"2.5 + 1.7 等於多少？","options":{"A":"3.2","B":"4.2","C":"4.12","D":"3.12"},"answer":"B","explanation":"十分位相加進位，2.5 + 1.7 = 4.2。"},
    {"id":"K4-004","grade":"K4","question":"18 + 6 × 3 等於多少？","options":{"A":"72","B":"54","C":"24","D":"36"},"answer":"D","explanation":"先乘後加：6 × 3 = 18，再算 18 + 18 = 36。"},
    {"id":"K4-005","grade":"K4","question":"把 3476 四捨五入到百位，結果是多少？","options":{"A":"3400","B":"3480","C":"3500","D":"3000"},"answer":"C","explanation":"十位是 7，百位進 1，得到 3500。"},
    {"id":"K4-006","grade":"K4","question":"一個直角是多少度？","options":{"A":"45 度","B":"60 度","C":"90 度","D":"180 度"},"answer":"C","explanation":"直角是 90 度。"},
    {"id":"K5-001","grade":"K5","question":"1/2 + 1/3 等於多少？","options":{"A":"2/5","B":"5/6","C":"1/6","D":"2/6"},"answer":"B","explanation":"通分後為 3/6 + 2/6 = 5/6。"},
    {"id":"K5-002","grade":"K5","question":"三角形底 10 公分、高 6 公分，面積是多少平方公分？","options":{"A":"60","B":"16","C":"30","D":"32"},"answer":"C","explanation":"10 × 6 ÷ 2 = 30 平方公分。"},
    {"id":"K5-003","grade":"K5","question":"12 和 18 的最大公因數是多少？","options":{"A":"3","B":"6","C":"9","D":"36"},"answer":"B","explanation":"12 與 18 共同的因數有 1、2、3、6，最大是 6。"},
    {"id":"K5-004","grade":"K5","question":"4 和 6 的最小公倍數是多少？","options":{"A":"2","B":"10","C":"12","D":"24"},"answer":"C","explanation":"4 與 6 最小的共同正倍數是 12。"},
    {"id":"K5-005","grade":"K5","question":"長方體長 5、寬 4、高 3 公分，體積是多少立方公分？","options":{"A":"12","B":"47","C":"60","D":"94"},"answer":"C","explanation":"體積 = 5 × 4 × 3 = 60 立方公分。"},
    {"id":"K5-006","grade":"K5","question":"0.6 × 0.4 等於多少？","options":{"A":"0.24","B":"2.4","C":"0.024","D":"1.0"},"answer":"A","explanation":"6 × 4 = 24，兩個因數共有兩位小數，答案是 0.24。"},
    {"id":"K6-001","grade":"K6","question":"一件衣服原價 200 元，打八折後是多少元？","options":{"A":"180","B":"160","C":"120","D":"80"},"answer":"B","explanation":"八折是原價的 80%，200 × 0.8 = 160 元。"},
    {"id":"K6-002","grade":"K6","question":"60 公里走了 2 小時，平均速率是多少公里／小時？","options":{"A":"120","B":"60","C":"30","D":"20"},"answer":"C","explanation":"速率 = 距離 ÷ 時間 = 60 ÷ 2 = 30。"},
    {"id":"K6-003","grade":"K6","question":"圓的半徑是 5 公分，圓周率取 3.14，面積是多少平方公分？","options":{"A":"31.4","B":"78.5","C":"15.7","D":"157"},"answer":"B","explanation":"面積 = 3.14 × 5 × 5 = 78.5 平方公分。"},
    {"id":"K6-004","grade":"K6","question":"甲與乙的人數比為 2：3，共有 25 人，甲有幾人？","options":{"A":"5","B":"10","C":"15","D":"20"},"answer":"B","explanation":"共 5 份，每份 25 ÷ 5 = 5 人；甲有 2 × 5 = 10 人。"},
    {"id":"K6-005","grade":"K6","question":"4 次測驗分數為 70、80、90、100，平均是多少分？","options":{"A":"80","B":"85","C":"90","D":"95"},"answer":"B","explanation":"(70 + 80 + 90 + 100) ÷ 4 = 85。"},
    {"id":"K6-006","grade":"K6","question":"3/4 ÷ 1/2 等於多少？","options":{"A":"3/8","B":"2/3","C":"3/2","D":"1/4"},"answer":"C","explanation":"除以 1/2 相當於乘以 2，3/4 × 2 = 3/2。"}
  ]
